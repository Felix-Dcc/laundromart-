# Baked into the build by `vite build` (production mode). The admin dashboard
# talks to the deployed backend. This is a public URL, not a secret.
# Update this if the backend domain changes, then redeploy.
VITE_API_URL=https://humble-vision-production-964d.up.railway.app/api

# reCAPTCHA v3 (optional). Create a v3 key pair at google.com/recaptcha/admin
# for the domain laundromart.xyz. Put the SITE key here (public, baked into the
# build) and the SECRET key as RECAPTCHA_SECRET_KEY on the BACKEND Railway
# service. Leave blank to keep reCAPTCHA disabled — login works either way.
# VITE_RECAPTCHA_SITE_KEY=
