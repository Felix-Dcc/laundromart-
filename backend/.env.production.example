# Copy to backend/.env.production and fill in real values before deploying.
# (DATABASE_URL and REDIS_URL are injected by docker-compose for the service
#  network; override here only for a non-Docker deploy.)

# Generate a strong secret:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="CHANGE_ME_TO_A_64_CHAR_RANDOM_STRING"
JWT_EXPIRES_IN="7d"

NODE_ENV=production
PORT=3000

# Behind Nginx / load balancer → keep true for correct client IPs + rate limiting.
TRUST_PROXY="true"

# Comma-separated web origins allowed by CORS (admin dashboard, etc.).
CORS_ORIGINS="https://admin.yourdomain.com,https://app.yourdomain.com"

# Rate limits
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Payments (Paystack — Ghana MoMo + cards). Use live keys in production.
PAYSTACK_SECRET_KEY="sk_live_xxx_or_sk_test_xxx"
PAYSTACK_PUBLIC_KEY="pk_live_xxx_or_pk_test_xxx"
PAYMENT_CURRENCY="GHS"

# App
APP_NAME="LAUNDROMAT"
CURRENCY="GH₵"
DEFAULT_TIMEZONE="Africa/Accra"
RECORDS_PER_PAGE=10
PASSWORD_MIN_LENGTH=8

# Push notifications (optional)
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# Used only for non-Docker deploys (Docker compose injects these):
# DATABASE_URL="postgresql://postgres:password@localhost:5432/laundry_management_system?schema=public"
# REDIS_URL="redis://localhost:6379"
