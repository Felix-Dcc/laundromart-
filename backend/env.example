# Copy this file to .env and update the values
# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/laundry_management_system?schema=public"

# JWT — MUST be 32+ chars in production (the server refuses to start otherwise).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
# Short-lived access token + rotating refresh token (auto-refreshed by the app).
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_DAYS=30

# Server
PORT=3000
NODE_ENV=development

# Redis (optional) — enables horizontal Socket.IO scaling + caching.
# Leave blank for single-instance dev (in-memory, no cache).
REDIS_URL=""

# Observability (all optional)
LOG_LEVEL=""                 # trace|debug|info|warn|error (defaults: info in prod, debug in dev)
SENTRY_DSN=""                # error tracking; blank = disabled
METRICS_TOKEN=""             # if set, /api/metrics requires ?token= or Bearer; else open

# Security / production hardening
# Comma-separated web origins allowed by CORS (leave blank in dev to reflect any origin).
CORS_ORIGINS=""
# Set to true when running behind Nginx / a load balancer (for correct client IPs).
TRUST_PROXY="false"
# Global rate limit (per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=1000
# Strict rate limit for /api/auth (per IP + email)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=20

# Firebase (for push notifications)
FIREBASE_PROJECT_ID=""
FIREBASE_PRIVATE_KEY=""
FIREBASE_CLIENT_EMAIL=""

# Payments — leave blank to run in STUB/sandbox mode (no live charges).
# Paystack handles Ghana Mobile Money (MTN/Vodafone/AirtelTigo) + cards.
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""
# Optional: Stripe for international cards (scaffolded).
STRIPE_SECRET_KEY=""
PAYMENT_CURRENCY="GHS"

# App
APP_NAME="LAUNDROMAT"
CURRENCY="GH₵"
DEFAULT_TIMEZONE="America/New_York"
RECORDS_PER_PAGE=10
PASSWORD_MIN_LENGTH=6
