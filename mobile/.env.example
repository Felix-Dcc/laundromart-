# Copy to .env for local development. Never commit .env — it is gitignored.
#
# NOTE: EXPO_PUBLIC_* variables are embedded in the app bundle and are readable
# by anyone who downloads it. Never put a private/secret key here. The Google
# Maps key below is a client key and is expected to be public — protect it with
# platform restrictions (bundle ID com.lms.laundromat) in Google Cloud Console,
# not by hiding it.

# ── API base URL ────────────────────────────────────────────────────────
# Local development — pick the one matching how you run the app:
#   Android emulator : http://10.0.2.2:3000/api   (localhost = the emulator, not your PC)
#   iOS simulator    : http://localhost:3000/api
#   Physical device  : http://<YOUR_PC_LAN_IP>:3000/api   (`ipconfig` → IPv4 Address)
#   Web              : http://localhost:3000/api
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000/api

# Production must be a public HTTPS domain, e.g.:
#   EXPO_PUBLIC_API_URL=https://api.yourdomain.com/api
# Production builds reject http:// or private addresses (see app.config.js).
# Set production values as EAS secrets rather than in this file:
#   eas secret:create --name EXPO_PUBLIC_API_URL --value https://api.yourdomain.com/api

# ── Google Maps ─────────────────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials. Enable billing and the
# "Maps SDK for Android", "Maps SDK for iOS" and "Directions API".
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
