# Production TLS config.
# Enable by: (1) place fullchain.pem + privkey.pem in ../certs (mounted at
# /etc/nginx/certs), (2) rename this file to laundromat.ssl.conf, (3) DELETE or
# edit laundromat.conf so port 80 only redirects to HTTPS, (4) reload nginx.
#
# Get free certs with certbot (webroot is already wired via /var/www/certbot):
#   docker run --rm -v $PWD/nginx/certs:/etc/letsencrypt \
#     -v $PWD/nginx/www:/var/www/certbot certbot/certbot certonly \
#     --webroot -w /var/www/certbot -d api.yourdomain.com

upstream laundromat_api_ssl {
    server api:3000;
    keepalive 32;
}

map $http_upgrade $connection_upgrade_ssl {
    default upgrade;
    ''      close;
}

# HTTP → HTTPS redirect (keep ACME challenge reachable on 80).
server {
    listen 80;
    server_name api.yourdomain.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name api.yourdomain.com;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_session_cache shared:SSL:10m;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;

    client_max_body_size 5m;
    gzip on;
    gzip_types application/json text/plain application/javascript text/css;

    location /socket.io/ {
        proxy_pass http://laundromat_api_ssl;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade_ssl;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location /api/ {
        proxy_pass http://laundromat_api_ssl;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
    }

    location / { return 404; }
}
